1
00:00:02,000 --> 00:00:04,000
متحدث ١: ألو.

2
00:00:04,000 --> 00:00:05,000
متحدث ٢: أيوه.

3
00:00:05,000 --> 00:00:09,000
متحدث ١: اتقوِل معاك يا راجل يا طيب.

4
00:00:09,000 --> 00:00:11,000
متحدث ١: أنت ما ما

5
00:00:11,000 --> 00:00:15,000
متحدث ١: ماسحت الحياة خالص؟

6
00:00:15,000 --> 00:00:16,000
متحدث ١: طويل!

7
00:00:16,000 --> 00:00:17,000
متحدث ١: اتقوِل!

8
00:00:17,000 --> 00:00:18,000
متحدث ٢: أزيك يا أحمد؟

9
00:00:18,000 --> 00:00:22,000
متحدث ١: أزيك يا أحمد أنت مخضوض؟

10
00:00:22,000 --> 00:00:25,000
متحدث ٢: لا أصل بتكلم من الساعة أربعه بس.

11
00:00:25,000 --> 00:00:26,000
متحدث ١: إيه؟

12
00:00:26,000 --> 00:00:27,000
متحدث ١: أاه.

13
00:00:27,000 --> 00:00:31,000
متحدث ١: من الساعة، ما خلاص بقى أنت مش [ضحك]

14
00:00:31,000 --> 00:00:33,000
متحدث ١: مش فاضي لأي حاجة.

15
00:00:33,000 --> 00:00:35,000
متحدث ٢: [غير واضح].

16
00:00:35,000 --> 00:00:37,000
متحدث ١: أنت فينك يا راجل يا طيب؟

17
00:00:37,000 --> 00:00:39,000
متحدث ١: خلعت؟

18
00:00:39,000 --> 00:00:40,000
متحدث ١: إيه؟

19
00:00:40,000 --> 00:00:41,000
متحدث ٢: في البيت والله يعني.

20
00:00:41,000 --> 00:00:43,000
متحدث ١: في البيت؟

21
00:00:43,000 --> 00:00:45,000
متحدث ٢: [غير واضح].

22
00:00:45,000 --> 00:00:48,000
متحدث ١: الحمد لله، تمام.

23
00:00:48,000 --> 00:00:49,000
متحدث ١: أاه

24
00:00:49,000 --> 00:00:54,000
متحدث ١: فجأة كده، تحسستك كده، بـ بدور عليك لقيتك بـ تخلع.

25
00:00:54,000 --> 00:00:57,000
متحدث ١: مشيت تقريبًا، أو كده.

26
00:00:57,000 --> 00:00:58,000
متحدث ٢: جيت بـ سرعة والله يا فادي.

27
00:00:58,000 --> 00:01:00,000
متحدث ١: جيت بـ سرعة؟

28
00:01:00,000 --> 00:01:03,000
متحدث ٢: [غير واضح].

29
00:01:03,000 --> 00:01:06,000
متحدث ١: كنت عايز أقول لك صحيح،

30
00:01:06,000 --> 00:01:14,000
متحدث ١: الواحد بـ يعني، بـ يفكر برضه كده، يعني، هل ده الواحد يعمل،

31
00:01:14,000 --> 00:01:20,000
متحدث ١: بـ يعمل كده يعني؟ هل أنت مثلًا شايف، مثلًا، اللي كان فيه مشكلة، أو تـ،

32
00:01:20,000 --> 00:01:23,000
متحدث ١: مـ مفيش توجيه باحترافية؟

33
00:01:23,000 --> 00:01:24,000
متحدث ٢: بتتكلم عن الكونيكت قصدك يعني؟

34
00:01:24,000 --> 00:01:27,000
متحدث ١: نفس اللقطة اللي كانت،

35
00:01:27,000 --> 00:01:28,000
متحدث ١: إيه؟

36
00:01:28,000 --> 00:01:29,000
متحدث ٢: بتتكلم عن الكونيكت قصدك يعني؟

37
00:01:29,000 --> 00:01:30,000
متحدث ١: إيه؟

38
00:01:30,000 --> 00:01:32,000
متحدث ٢: بـ تقول إيه يا أستاذ؟

39
00:01:32,000 --> 00:01:34,000
متحدث ١: صوتك بـ يقطع.

40
00:01:34,000 --> 00:01:36,000
متحدث ٢: انت بـ تتكلم عـ الكونيكت قصدك يعني؟

41
00:01:36,000 --> 00:01:37,000
متحدث ١: أاه.

42
00:01:37,000 --> 00:01:40,000
متحدث ٢: أاه والله، أصل أنا جالي أوفير بـ تايتل أعلى.

43
00:01:40,000 --> 00:01:45,000
متحدث ١: أاه.

44
00:01:45,000 --> 00:01:48,000
متحدث ١: مش، مش عشان،

45
00:01:48,000 --> 00:01:53,000
متحدث ١: بس هما عندهم هنا ما عندهمش مشكلة في التايتلز.

46
00:01:53,000 --> 00:01:57,000
متحدث ٢: ما هو الفكرة مش تايتل بس، [غير واضح] يعني بـ يبقوا حاطين، أاه.

47
00:01:57,000 --> 00:01:59,000
متحدث ١: أاه.

48
00:01:59,000 --> 00:02:03,000
متحدث ٢: أنا عايز الصراحة، ما فيش أمل بالـ [غير واضح] خالص،

49
00:02:03,000 --> 00:02:07,000
متحدث ١: أيوه، بـ الموضوع كله يعني.

50
00:02:07,000 --> 00:02:09,000
متحدث ٢: وهو بنفس الفويس برضه يعني [غير واضح].

51
00:02:09,000 --> 00:02:11,000
متحدث ١: إيه؟

52
00:02:11,000 --> 00:02:13,000
متحدث ٢: أنا رحت فويس.

53
00:02:13,000 --> 00:02:15,000
متحدث ١: مش، بـ تقول إيه؟

54
00:02:15,000 --> 00:02:17,000
متحدث ٢: أقولك رحت فويس.

55
00:02:17,000 --> 00:02:21,000
متحدث ١: ما يا عم صوتك بعد خالص.

56
00:02:21,000 --> 00:02:22,000
متحدث ٢: أنت سامعني كده؟

57
00:02:22,000 --> 00:02:23,000
متحدث ١: إيه؟

58
00:02:23,000 --> 00:02:26,000
متحدث ٢: سامعني كده؟

59
00:02:26,000 --> 00:02:29,000
متحدث ١: أاه، بـ تقول إيه بقى، بـوينتس؟

60
00:02:29,000 --> 00:02:31,000
متحدث ٢: فويس فويس.

61
00:02:31,000 --> 00:02:35,000
متحدث ١: فويس؟ ما فويس في ناس سابوا فويس وجوا.

62
00:02:35,000 --> 00:02:38,000
متحدث ٢: همم، في ناس سابوا الفويس برضه،

63
00:02:38,000 --> 00:02:49,000
متحدث ١: أيوه ألا، يعني مش عارف. طب أنت هما فويس عايزين داتا ساينتست على فكرة.

64
00:02:49,000 --> 00:02:52,000
متحدث ٢: لو عايزين قولي والله هاعمل لك ريفيرال على طول.

65
00:02:52,000 --> 00:02:58,000
متحدث ١: هما محتاجين أاه، نازلين بـ يقولك عايزين داتا ساينتست، ولا سينيور داتا ساينتست.

66
00:02:58,000 --> 00:03:00,000
متحدث ٢: همم.

67
00:03:00,000 --> 00:03:05,000
متحدث ١: فـ هما يعني نروح نشوف الدنيا عليها إيه.

68
00:03:05,000 --> 00:03:09,000
متحدث ٢: طب قدم طيب، وقولي، قدم وابعتلي،

69
00:03:09,000 --> 00:03:10,000
متحدث ١: أبعت لك إيه؟

70
00:03:10,000 --> 00:03:12,000
متحدث ٢: إبعت لي اللينك اللي هـ تقدم عليه.

71
00:03:12,000 --> 00:03:14,000
متحدث ١: ماشي.

72
00:03:14,000 --> 00:03:18,000
متحدث ١: يعني بـ أقدم أنا وبـ أبعت لك اللينك.

73
00:03:18,000 --> 00:03:20,000
متحدث ٢: وأنا بقى هـ أبعته لـ الإتش آر،

74
00:03:20,000 --> 00:03:21,000
متحدث ١: أاه.

75
00:03:21,000 --> 00:03:25,000
متحدث ٢: على أساس الماركت كله على علم بـ الشغل هينزل عليه،

76
00:03:25,000 --> 00:03:28,000
متحدث ٢: وأبعته لـ الإتش آر دي و أسمع من عندهم عامل إزاي، عشان إن أنت،

77
00:03:28,000 --> 00:03:30,000
متحدث ١: ماشي.

78
00:03:30,000 --> 00:03:32,000
متحدث ٢: بـ يبقوا حاطين عندهم ريفيرال برضه [غير واضح]،

79
00:03:32,000 --> 00:03:34,000
متحدث ١: أاه.

80
00:03:34,000 --> 00:03:38,000
متحدث ١: هي دي الـ هي دي الفكرة يعني يا كبير.

81
00:03:38,000 --> 00:03:44,000
متحدث ١: ثم أنت يا عم أنت، أنت خلاص أنت خلاص بـ أقول لك ألحقني قبل ما أتجوز سودانية.

82
00:03:44,000 --> 00:03:45,000
متحدث ٢: والله؟

83
00:03:45,000 --> 00:03:48,000
متحدث ١: أاه.

84
00:03:48,000 --> 00:03:55,000
متحدث ١: ليه؟ إيه اللي ليه بقى؟ ما خلاص بقى ما فـ بـ بنات البلد دول خلاص، طموحاتهم يبقوا وزراء.

85
00:03:55,000 --> 00:03:57,000
متحدث ٢: يعني يا هـ تروح السودانية يا،

86
00:03:57,000 --> 00:04:06,000
متحدث ١: أيوه يا عم هما دول اللي عايزين يبقوا وزراء و رـ ورؤساء مجالس إدارات، إحنا عايزين حد نفتح بيت يا عم.

87
00:04:06,000 --> 00:04:10,000
متحدث ١: وواحدة مريحة وخلاص.

88
00:04:10,000 --> 00:04:14,000
متحدث ١: وعايزين يؤمنوا مستقبل القارة الإفريقية.

89
00:04:14,000 --> 00:04:20,000
متحدث ١: بـ يقول لك يا عم إمضيلنا على على المية تجمد.

90
00:04:20,000 --> 00:04:23,000
متحدث ١: مش هو ده الـ، إيه؟

91
00:04:23,000 --> 00:04:26,000
متحدث ٢: هي كلها كده يا مسعود، بـ تبقى حاجة تانية طيب؟

92
00:04:26,000 --> 00:04:29,000
متحدث ١: ما إحنا عمالين بـ ندور بـ قالنا ثلاث سنين أهو يا عم.

93
00:04:29,000 --> 00:04:42,000
متحدث ١: واللي رُحنا شوفناهم نفس الفكرة بتاع الـ السوريات الـ أنا بـ أقول لك عليها، أقال لك ده ده ده خطيبها بـ يبات معاهم وبتاع، وتسيبها تـ تسلم على الناس.

94
00:04:42,000 --> 00:04:51,000
متحدث ١: لقيت العملية إيه، فهو الراجل نفسه لما لقاني مـ متحشم كده، قال لك مش نافعنا ده.

95
00:04:51,000 --> 00:04:54,000
متحدث ١: ولا أنت فيه عرفت سبب تاني؟

96
00:04:54,000 --> 00:04:56,000
متحدث ٢: لا والله، أنا مـ ما أعرفش،

97
00:04:56,000 --> 00:04:57,000
متحدث ٢: [غير واضح] معاه.

98
00:04:57,000 --> 00:04:59,000
متحدث ١: طيب.

99
00:04:59,000 --> 00:05:05,000
متحدث ١: خلاص أنت، تنزل مصر إمتى يا عم، عايزين نـ نتغدى كده ونقعد نفكر في الحوارات دي.

100
00:05:05,000 --> 00:05:08,000
متحدث ١: وغـ وعليك تغير جو كده و،

101
00:05:08,000 --> 00:05:10,000
متحدث ٢: أنا هناك النهاردة.

102
00:05:10,000 --> 00:05:11,000
متحدث ١: إيه؟

103
00:05:11,000 --> 00:05:12,000
متحدث ٢: هناك النهاردة.

104
00:05:12,000 --> 00:05:14,000
متحدث ١: هناك فين؟

105
00:05:14,000 --> 00:05:15,000
متحدث ٢: هناك النهاردة.

106
00:05:15,000 --> 00:05:16,000
متحدث ١: في فويس؟

107
00:05:16,000 --> 00:05:18,000
متحدث ٢: أاه، ما أنا بروح هناك.

108
00:05:18,000 --> 00:05:22,000
متحدث ١: أنت في القرية يعني؟

109
00:05:22,000 --> 00:05:24,000
متحدث ١: إيه؟

110
00:05:24,000 --> 00:05:27,000
متحدث ٢: هي قريبة من الشارقة، فـ أقدر أروح وأجي.

111
00:05:27,000 --> 00:05:30,000
متحدث ١: قـ القرية، القرية، القرية الذكية؟

112
00:05:30,000 --> 00:05:32,000
متحدث ٢: قريبة من الشرقية برضه.

113
00:05:32,000 --> 00:05:34,000
متحدث ٢: على المحور، تطلع على المحور وتنزل على طول.

114
00:05:34,000 --> 00:05:38,000
متحدث ١: مش هو المكان فويس ده اللي في القرية الذكية؟

115
00:05:38,000 --> 00:05:40,000
متحدث ١: ولا مكان تاني؟

116
00:05:40,000 --> 00:05:42,000
متحدث ٢: القرية الذكية.

117
00:05:42,000 --> 00:05:45,000
متحدث ١: القرية الذكية!

118
00:05:45,000 --> 00:05:51,000
متحدث ١: ماشي ما أنا ممكن أبقى أروح القرية الذكية عشان خاطر أقدم أوراق، كان، ده أنا شغال في الرقابة أنا.

119
00:05:51,000 --> 00:05:53,000
متحدث ٢: يعني فيه حاجة هـ تعملها هناك يعني؟

120
00:05:53,000 --> 00:05:54,000
متحدث ١: أاه.

121
00:05:54,000 --> 00:05:59,000
متحدث ٢: قشطة، أنت عرفت أنت رايح إمتى؟ وأنا، أنت رايح الأحد الجاي، هـ أنزل النهاردة إن شاء الله.

122
00:05:59,000 --> 00:06:02,000
متحدث ١: أنت بـ تروح كل يوم أحد؟

123
00:06:02,000 --> 00:06:04,000
متحدث ٢: لا، أوقات بـ أروح الأحد.

124
00:06:04,000 --> 00:06:05,000
متحدث ١: أاه.

125
00:06:05,000 --> 00:06:09,000
متحدث ٢: لا، غير كده بـ أروح المعادي، عشان،

126
00:06:09,000 --> 00:06:11,000
متحدث ١: في المعادي فويس برضه؟

127
00:06:11,000 --> 00:06:14,000
متحدث ٢: ممم، المعادي فيها فرع تاني.

128
00:06:14,000 --> 00:06:19,000
متحدث ١: والناس الإنترفيوهات بتاعتها سهلة وسلسة كده، ولا بـ يقعدوا ياكلوا دراع الناس وكده؟

129
00:06:19,000 --> 00:06:22,000
متحدث ٢: والله بالنسبة لي الإنترفيو كان أسهل،

130
00:06:22,000 --> 00:06:24,000
متحدث ١: هما كانوا عارفينك يعني؟

131
00:06:24,000 --> 00:06:27,000
متحدث ٢: ولا عارفينني ولا أي ولا نيلة.

132
00:06:27,000 --> 00:06:33,000
متحدث ١: إنما هما عايزين حد، يعني أنت يا ابني أنت بـ تفهم؟ أاه والله العظيم بـ افهم، خلاص اتفضل.

133
00:06:33,000 --> 00:06:36,000
متحدث ٢: والله هي أسباب توفيق من عند ربنا ما أعرفش والله العظيم.

134
00:06:36,000 --> 00:06:44,000
متحدث ١: ما كانش بـ يعني ما كانش بـ يجي يقول لك بقى الـ الجافا يعني إيه والـ السكريبت ليه؟

135
00:06:44,000 --> 00:06:46,000
متحدث ٢: والله هما بـ يكلموني.

136
00:06:46,000 --> 00:06:47,000
متحدث ١: أاه.

137
00:06:47,000 --> 00:06:49,000
متحدث ٢: وبـ يقلولي، يعني إنت بـ تعتبر الأساس.

138
00:06:49,000 --> 00:06:51,000
متحدث ١: إيه؟

139
00:06:51,000 --> 00:06:53,000
متحدث ٢: هما بـ يبعتولي اللينك أ أقدم.

140
00:06:53,000 --> 00:06:56,000
متحدث ١: اللينك يعني تـ تقدم.

141
00:06:56,000 --> 00:06:57,000
متحدث ٢: اه والله.

142
00:06:57,000 --> 00:07:03,000
متحدث ١: ماشي، و والكلام كان، قصدي يعني، الكلام سلس يعني، ما هماش بـ يفحسوا في الحاجة.

143
00:07:03,000 --> 00:07:09,000
متحدث ٢: يا عم، ما، حد فاهم؟ هو بـ يبقى عايزك تبقى شاطر.

144
00:07:09,000 --> 00:07:11,000
متحدث ١: إيه؟

145
00:07:11,000 --> 00:07:12,000
متحدث ٢: عايز يـ هاير.

146
00:07:12,000 --> 00:07:14,000
متحدث ١: أاه، عايز يـ هاير.

147
00:07:14,000 --> 00:07:18,000
متحدث ٢: إنما بـ يقعد بقى يلف على عشان، [غير واضح] اللي هو عايزه.

148
00:07:18,000 --> 00:07:21,000
متحدث ٢: الصراحة بـ ألاقي إقتناع.

149
00:07:21,000 --> 00:07:23,000
متحدث ١: أاه.

150
00:07:23,000 --> 00:07:27,000
متحدث ١: طب خلاص، أنا هـ اشوف الحاجات دي وأكلمك بقى، أبعت هالك.

151
00:07:27,000 --> 00:07:29,000
متحدث ٢: قشطة، هـ أستناك تبعتها.

152
00:07:29,000 --> 00:07:31,000
متحدث ١: ماشي، بس ما تفضحناش بقى.

153
00:07:31,000 --> 00:07:34,000
متحدث ٢: لا عيب عليك والله. [ضحك]

154
00:07:34,000 --> 00:07:37,000
متحدث ١: ماشي يا كبير.

155
00:07:37,000 --> 00:07:41,000
متحدث ١: ماشي، يلا، ألف مبروك، سلام عليكم.

