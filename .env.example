# انسخ هذا الملف إلى .env واملأ ما تحتاجه فقط.
# على GitHub لا تستخدم هذا الملف إطلاقًا -- ضع المفاتيح في:
#   Settings -> Secrets and variables -> Actions -> New repository secret

# مجاني: https://aistudio.google.com/apikey
# تنبيه: الطبقة المجانية تُستخدم في تحسين منتجات Google وقد يقرأها مراجع بشري.
# لتسجيلاتك الشخصية الحساسة، اربط الفوترة (تصير الطبقة المدفوعة = لا تدريب)
# أو استخدم الوضع المحلي local.
GEMINI_API_KEY=

# مجاني: https://console.groq.com/keys
GROQ_API_KEY=

# مدفوع: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- إعدادات اختيارية ---
# PROVIDER=local
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=whisper-large-v3
# ELEVENLABS_MODEL=scribe_v2
# WHISPER_SIZE=large-v3
# HINTS=أحمد,منى,شركة كذا
